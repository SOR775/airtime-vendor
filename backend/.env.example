# ---- Server ----
PORT=4000
NODE_ENV=development
APP_BASE_URL=https://your-domain-or-ngrok-url.ngrok-free.app

# ---- Database ----
# Postgres is recommended for financial records (ACID transactions)
DATABASE_URL="postgresql://user:password@localhost:5432/airtime_vendor"

# ---- Safaricom Daraja (M-Pesa) ----
# Get these from https://developer.safaricom.co.ke after creating an app
DARAJA_ENV=sandbox                     # sandbox | production
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379                # Paybill/Till number (sandbox default shown)
DARAJA_PASSKEY=                        # Lipa Na M-Pesa Online Passkey
DARAJA_CALLBACK_URL=${APP_BASE_URL}/api/payments/callback

# ---- Airtime delivery provider ----
# Choose ONE: "safaricom_bulk" (direct Safaricom Bulk Airtime API, requires
# separate approval from Safaricom) or an aggregator that already resells
# Safaricom airtime via API, e.g. "africastalking" or "statum".
AIRTIME_PROVIDER=africastalking
AIRTIME_API_KEY=
AIRTIME_USERNAME=
AIRTIME_BASE_URL=

# Minimum amount (KES) supported by the configured airtime provider.
# Use 5 for production providers like Statum; set to 1 during local development
# if you want to test small amounts (the service may fall back to mock delivery).
AIRTIME_MIN_AMOUNT=5

# ---- Security ----
JWT_SECRET=replace_with_a_long_random_string
WEBHOOK_SHARED_SECRET=replace_with_a_long_random_string
CORS_ORIGIN=http://localhost:5173

# ---- Frontend ----
# Set this in the frontend service environment if it is deployed separately
VITE_API_BASE_URL=/api

# ---- AI / Claude ----
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3.5-mini



# SMTP (Gmail)
